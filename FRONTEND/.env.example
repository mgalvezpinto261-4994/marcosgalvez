# URL base del microservicio "catalogo" (categorías y servicios de empresas).
# En desarrollo local corre en el puerto 8083 (ver BACKEND/catalogo/src/main/resources/application.yaml).
VITE_CATALOGO_API_URL=http://localhost:8083

# URL base del microservicio "usuarios" (registro/login, JWT).
# En desarrollo local corre en el puerto 8081 (ver BACKEND/usuarios/src/main/resources/application.yaml).
VITE_USUARIOS_API_URL=http://localhost:8081

# URL base del microservicio "ofertas" (ofertas de trabajo, postulaciones y cotizaciones).
# En desarrollo local corre en el puerto 8084 (ver BACKEND/ofertas/src/main/resources/application.yaml).
VITE_OFERTAS_API_URL=http://localhost:8084

# URL base del microservicio "perfiles" (edición de perfiles de empresa/profesional/cliente).
# En desarrollo local corre en el puerto 8082 (ver BACKEND/perfiles/src/main/resources/application.yaml).
VITE_PERFILES_API_URL=http://localhost:8082

# URL base del microservicio "resenias" (reseñas de clientes a profesionales).
# En desarrollo local corre en el puerto 8085 (ver BACKEND/resenias/src/main/resources/application.yaml).
VITE_RESENIAS_API_URL=http://localhost:8085

# URL base del microservicio "notificaciones".
# En desarrollo local corre en el puerto 8086 (ver BACKEND/notificaciones/src/main/resources/application.yaml).
VITE_NOTIFICACIONES_API_URL=http://localhost:8086
